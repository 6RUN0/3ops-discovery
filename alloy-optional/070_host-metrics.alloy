// Opt-in host metrics (manifest 14.5). Lives in alloy-optional/, outside
// the base alloy/: the base config is valid without it, and the only
// reference points INTO a base output (090). The exporter reads the host
// procfs/sysfs/rootfs mounted into the collector container at the paths
// below; deployments relocate the mounts via the RU_3OPS_DISCOVERY_HOST_*
// env vars (manifest 14.1). Series are the standard node_* set.
//
// Boundary rule (manifest 14.3): host-level, deployment-privileged
// telemetry is optional, never part of the discovery-driven base.

prometheus.exporter.unix "host" {
	rootfs_path = coalesce(sys.env("RU_3OPS_DISCOVERY_HOST_ROOTFS_PATH"), "/rootfs")
	procfs_path = coalesce(sys.env("RU_3OPS_DISCOVERY_HOST_PROCFS_PATH"), "/host/proc")
	sysfs_path  = coalesce(sys.env("RU_3OPS_DISCOVERY_HOST_SYSFS_PATH"), "/host/sys")
}

// Provenance (manifest 6.1): the exporter target carries no docker
// discovery metadata, so collector/host are attached here -- without
// them the node_* series cannot be told apart per collector in a
// multi-host installation.
discovery.relabel "host_metrics" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "collector"
		replacement  = "alloy"
	}

	rule {
		target_label = "host"
		replacement  = constants.hostname
	}
}

prometheus.scrape "host" {
	targets          = discovery.relabel.host_metrics.output
	follow_redirects = false
	forward_to       = [prometheus.remote_write.default.receiver]
}
