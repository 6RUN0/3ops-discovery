# https://editorconfig.org -- editor defaults matching the gates.
# Default indent is 2 spaces (YAML, TOML, JSON and the docs' code
# samples). Python is 4 spaces, matching `ruff format` and enforced
# here including docstring bodies.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 79

# alloy fmt output style; alloy_check (fmt -t) is the authority -- the
# tool indents with tabs (gofmt-style), so this section follows it, not
# vice versa. If a future Alloy release changes the style, update the
# files with `alloy fmt -w` and this section together.
[*.alloy]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

# Markdown embeds code samples in several languages (2-space YAML, alloy,
# text ladders), so no single indent width applies; unset lets
# editorconfig-checker skip indentation here while other rules stay on.
[*.md]
trim_trailing_whitespace = false
indent_size = unset
