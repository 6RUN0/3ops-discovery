foreach "redis" {
	collection = discovery.relabel.database_redis.output
	var        = "each"
	id         = "__meta_docker_container_label_ru_3ops_discovery_database_secret_id"

	template {
		// redis_addr is a plain-string argument and cannot accept a Secret,
		// so the address (host:port, not sensitive) is read as a non-secret
		// file while the password comes from a separate secret file. The
		// secret contract therefore uses two files for redis: <id>.dsn holds
		// host:port and <id>.redispass holds the password (manifest 9).
		local.file "addr" {
			filename  = coalesce(sys.env("RU_3OPS_DISCOVERY_SECRETS_DIR"), "/run/alloy-secrets") + "/" + each["__meta_docker_container_label_ru_3ops_discovery_database_secret_id"] + ".dsn"
			is_secret = false
		}

		local.file "password" {
			filename  = coalesce(sys.env("RU_3OPS_DISCOVERY_SECRETS_DIR"), "/run/alloy-secrets") + "/" + each["__meta_docker_container_label_ru_3ops_discovery_database_secret_id"] + ".redispass"
			is_secret = true
		}

		// Profile-driven collection scope (manifest 8.4): basic-v1 keeps
		// only redis_* series (drops the exporter's own Go runtime
		// metrics); extended-v1 adds client-list and system memory
		// metrics on top of the defaults.
		prometheus.exporter.redis "db" {
			redis_addr     = local.file.addr.content
			redis_password = local.file.password.content

			redis_metrics_only  = coalesce(each["__meta_docker_container_label_ru_3ops_discovery_database_profile"], "standard-v1") == "basic-v1"
			export_client_list  = coalesce(each["__meta_docker_container_label_ru_3ops_discovery_database_profile"], "standard-v1") == "extended-v1"
			incl_system_metrics = coalesce(each["__meta_docker_container_label_ru_3ops_discovery_database_profile"], "standard-v1") == "extended-v1"
		}

		discovery.relabel "enrich_redis" {
			targets = prometheus.exporter.redis.db.targets

			rule {
				target_label = "environment"
				replacement  = coalesce(each["__meta_docker_container_label_ru_3ops_discovery_environment"], "")
			}

			rule {
				target_label = "team"
				replacement  = coalesce(each["__meta_docker_container_label_ru_3ops_discovery_team"], "")
			}

			rule {
				target_label = "compose_project"
				replacement  = coalesce(each["__meta_docker_container_label_com_docker_compose_project"], "")
			}

			rule {
				target_label = "compose_service"
				replacement  = coalesce(each["__meta_docker_container_label_com_docker_compose_service"], "")
			}

			rule {
				target_label = "__tmp_container"
				replacement  = each["__meta_docker_container_name"]
			}

			rule {
				source_labels = ["__tmp_container"]
				regex         = "/(.*)"
				replacement   = "$1"
				target_label  = "container"
			}

			rule {
				target_label = "collector"
				replacement  = "alloy"
			}

			rule {
				target_label = "host"
				replacement  = constants.hostname
			}

			rule {
				target_label = "job"
				replacement  = each["__meta_docker_container_label_ru_3ops_discovery_database_type"]
			}

			rule {
				target_label = "instance"
				replacement  = each["__meta_docker_container_label_ru_3ops_discovery_database_secret_id"]
			}
			// Declared identity wins (manifest 5, 10.2.1): database.instance
			// first, the global instance label next; the synthesized secret
			// id above stays as the fallback. An absent key coalesces to "",
			// which the (.+) copy-rule ignores.
			rule {
				target_label = "__tmp_declared_instance"
				replacement  = coalesce(each["__meta_docker_container_label_ru_3ops_discovery_database_instance"], each["__meta_docker_container_label_ru_3ops_discovery_instance"], "")
			}

			rule {
				source_labels = ["__tmp_declared_instance"]
				regex         = "(.+)"
				target_label  = "instance"
			}
		}

		prometheus.scrape "db" {
			targets          = discovery.relabel.enrich_redis.output
			follow_redirects = false

			forward_to = [
				prometheus.remote_write.default.receiver,
			]
		}
	}
}

