// Metrics domain: containers that expose a Prometheus-compatible endpoint.
// The shared relabel below carries validation and provenance only, so its
// output means "reached profile routing", not "will be scraped": a target
// declaring an unknown profile is still visible here and is dropped by
// every profile filter downstream. One thin filter/scrape pair per
// profile from the manifest 8.2 allowlist routes targets to the pair's
// interval; the pair's component labels derive from the full profile
// name (fast-v1 -> metrics_fast_v1), which a static gate asserts.

discovery.relabel "metrics" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_enabled",
		]
		regex  = "true"
		action = "keep"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_type",
		]
		regex  = "prometheus"
		action = "keep"
	}

	// Validation (manifest section 11): metrics.path must start with "/",
	// metrics.scheme must be http or https. Empty means "use the default";
	// targets with invalid values are dropped.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_path",
		]
		regex  = "(/.*)?"
		action = "keep"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_scheme",
		]
		regex  = "(https?)?"
		action = "keep"
	}

	// metrics.port is mandatory (manifest 10.1.1) and must fail closed
	// (manifest 11). The keepequal below cannot enforce presence on its
	// own: a container with no exposed TCP ports rides the
	// discovery.docker fallback target, which carries no
	// __meta_docker_port_private, so keepequal would compare two empty
	// strings and pass -- scraping the container on port 80.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_port",
		]
		regex  = "(.+)"
		action = "keep"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_port",
		]
		target_label = "__tmp_metrics_port"
	}

	// discovery.docker emits one target per exposed port of the container,
	// on one network only (match_first_network keeps the first by name),
	// so the port is the whole fan-out; keep the target whose private port
	// matches the declared metrics port. The multi-network risk is not
	// duplication but reachability: the chosen network is arbitrary, and
	// an unreachable one shows up as up == 0 (manifest section 14).
	rule {
		source_labels = ["__meta_docker_port_private"]
		target_label  = "__tmp_metrics_port"
		action        = "keepequal"
	}

	rule {
		source_labels = [
			"__meta_docker_network_ip",
			"__meta_docker_port_private",
		]
		separator    = ":"
		target_label = "__address__"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_path",
		]
		regex        = "(.+)"
		replacement  = "$1"
		target_label = "__metrics_path__"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_scheme",
		]
		regex        = "(.+)"
		replacement  = "$1"
		target_label = "__scheme__"
	}

	// metrics.job is mandatory (manifest 10.1.1) and must fail closed
	// (manifest 11): without the presence keep an absent label yields an
	// empty job, relabel drops the empty label and prometheus.scrape
	// substitutes its own component name as the series job.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_job",
		]
		regex  = "(.+)"
		action = "keep"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_job",
		]
		target_label = "job"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_instance",
		]
		target_label = "instance"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_environment",
		]
		target_label = "environment"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_team",
		]
		target_label = "team"
	}

	// Provenance labels (manifest sections 6.1, 13.5): container comes
	// from Docker engine metadata and host from the Alloy collector's own
	// hostname; neither can be set via container labels, so a container
	// cannot claim another identity in them even though job, team and
	// environment above are self-declared.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		replacement   = "$1"
		target_label  = "container"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_com_docker_compose_project",
		]
		target_label = "compose_project"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_com_docker_compose_service",
		]
		target_label = "compose_service"
	}

	rule {
		target_label = "collector"
		replacement  = "alloy"
	}

	rule {
		target_label = "host"
		replacement  = constants.hostname
	}
}

// Profile allowlist (manifest 8.2): each thin filter below serves exactly
// one profile; normal-v1 is the default when the label is unset, so only
// its regex also accepts the empty value.

discovery.relabel "metrics_normal_v1" {
	targets = discovery.relabel.metrics.output

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_profile",
		]
		regex  = "(normal-v1)?"
		action = "keep"
	}
}

// The scrape response is an untrusted input too (manifest 13.5): the
// address is built from container metadata, but a 302 answer would send
// the next request wherever the responder likes -- a link-local metadata
// endpoint no label could ever name. Pinned in every prometheus.scrape
// of the reference and held there by a static gate, because the omission
// regresses silently the moment a profile pair is copied.
prometheus.scrape "metrics_normal_v1" {
	targets          = discovery.relabel.metrics_normal_v1.output
	scrape_interval  = "30s"
	scrape_timeout   = "10s"
	follow_redirects = false

	forward_to = [
		prometheus.remote_write.default.receiver,
	]
}

discovery.relabel "metrics_fast_v1" {
	targets = discovery.relabel.metrics.output

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_profile",
		]
		regex  = "(fast-v1)"
		action = "keep"
	}
}

prometheus.scrape "metrics_fast_v1" {
	targets          = discovery.relabel.metrics_fast_v1.output
	scrape_interval  = "15s"
	scrape_timeout   = "10s"
	follow_redirects = false

	forward_to = [
		prometheus.remote_write.default.receiver,
	]
}

discovery.relabel "metrics_slow_v1" {
	targets = discovery.relabel.metrics.output

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_metrics_profile",
		]
		regex  = "(slow-v1)"
		action = "keep"
	}
}

prometheus.scrape "metrics_slow_v1" {
	targets          = discovery.relabel.metrics_slow_v1.output
	scrape_interval  = "60s"
	scrape_timeout   = "15s"
	follow_redirects = false

	forward_to = [
		prometheus.remote_write.default.receiver,
	]
}
