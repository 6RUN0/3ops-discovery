// Reference implementation of the 3ops Discovery manifest.
// Not a complete production config; the *.alloy files in this directory
// form one Alloy configuration: alloy run <directory>.
// The numeric filename prefix fixes the reading order (pipeline flow)
// only: Alloy merges every file into one component graph, so the load
// order has no semantic effect.
//
// Environment overrides (RU_3OPS_DISCOVERY_ = 3ops Discovery):
//   RU_3OPS_DISCOVERY_DOCKER_HOST              Docker daemon address
//   RU_3OPS_DISCOVERY_DOCKER_REFRESH_INTERVAL  target list refresh interval

// Metrics/database discovery: only containers that explicitly opt in
// via the ru.3ops.discovery.enabled label.
discovery.docker "containers" {
	host             = coalesce(sys.env("RU_3OPS_DISCOVERY_DOCKER_HOST"), "unix:///var/run/docker.sock")
	refresh_interval = coalesce(sys.env("RU_3OPS_DISCOVERY_DOCKER_REFRESH_INTERVAL"), "30s")

	filter {
		name   = "label"
		values = ["ru.3ops.discovery.enabled=true"]
	}
}

// Log discovery covers all containers: logs are collected by default,
// ru.3ops.discovery.logs.enabled=false is the explicit opt-out.
discovery.docker "docker_logs" {
	host             = coalesce(sys.env("RU_3OPS_DISCOVERY_DOCKER_HOST"), "unix:///var/run/docker.sock")
	refresh_interval = coalesce(sys.env("RU_3OPS_DISCOVERY_DOCKER_REFRESH_INTERVAL"), "30s")
}
