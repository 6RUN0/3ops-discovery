// Blackbox domain (manifest 10.4): containers that ask Alloy to probe them
// over the network. Same layered shape as 020_metrics -- a shared relabel
// carrying validation, target composition and provenance, then one thin
// filter/scrape pair per manifest 8.2 profile -- but the target is a
// synthetic probe target handed to a shared blackbox exporter, not the
// container's own endpoint. The exporter and its enrich step sit between
// the shared relabel and the profile filters: the exporter passes labels
// through untouched except the ones it consumes (module, name) and
// overwrites (__address__, instance, job), so the raw profile label is
// still there for the filters to route on.
//
// The reference ships modules http_2xx, tcp_connect, icmp and
// tls_connect -- all four probe families the manifest promises. Add a
// module by extending the exporter `config` allowlist, the module
// keep-rule regex AND a composition rule together (a static gate asserts
// the three stay equal); add a profile by copying a thin filter/scrape
// pair.
//
// prometheus.exporter.blackbox is GA in v1.17.1: no experimental flag.

discovery.relabel "blackbox" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_enabled",
		]
		regex  = "true"
		action = "keep"
	}

	// Module allowlist (manifest 10.4.1): only modules defined in the
	// exporter `config` below are accepted. Keep this regex, the config
	// modules and the composition rules identical -- test_blackbox.py
	// asserts it.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_module",
		]
		regex  = "(http_2xx|tcp_connect|icmp|tls_connect)"
		action = "keep"
	}

	// Validation (manifest 11): scheme must be http or https when set; path
	// must start with "/" when set. Empty means "use the default".
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_scheme",
		]
		regex  = "(https?)?"
		action = "keep"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_path",
		]
		regex  = "(/.*)?"
		action = "keep"
	}

	// Collapse the per-port target fan-out and validate the declared probe
	// port against a real private port: keepequal drops the target when the
	// port is non-numeric, out of range or absent on the container. This
	// applies to icmp targets too even though the probe itself is portless
	// (manifest 10.4).
	// blackbox.port is mandatory even for portless icmp probes (manifest
	// 10.4.1) and must fail closed (manifest 11). Without this presence
	// keep, a container with no exposed TCP ports rides the
	// discovery.docker fallback target (no __meta_docker_port_private),
	// keepequal compares two empty strings and passes, and the icmp
	// composition -- which never consults the port -- probes anyway.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_port",
		]
		regex  = "(.+)"
		action = "keep"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_port",
		]
		target_label = "__tmp_bb_port"
	}

	rule {
		source_labels = ["__meta_docker_port_private"]
		target_label  = "__tmp_bb_port"
		action        = "keepequal"
	}

	// Probe host: the blackbox.address label if set, else the container IP.
	// Two rules, override-if-present (relabel has no coalesce): the default
	// is written first, the label overwrites it only when non-empty.
	rule {
		source_labels = ["__meta_docker_network_ip"]
		target_label  = "__tmp_bb_host"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_address",
		]
		regex        = "(.+)"
		target_label = "__tmp_bb_host"
	}

	// Scheme default http, overridden by the label when set.
	rule {
		target_label = "__tmp_bb_scheme"
		replacement  = "http"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_scheme",
		]
		regex        = "(.+)"
		target_label = "__tmp_bb_scheme"
	}

	// Path default empty, overridden by the label when set.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_path",
		]
		target_label = "__tmp_bb_path"
	}

	// Compose the probe target per module: the prober dictates the shape
	// (manifest 10.4) -- http wants a URL, tcp wants host:port, icmp wants
	// a bare host (a port there breaks name resolution). The module source
	// is the RAW docker label: the plain `module` label is only set further
	// below. __address__ becomes the blackbox __param_target (the thing
	// probed), NOT the scrape address -- the exporter overwrites
	// __address__ with its own in-memory address. One rule per module;
	// order is irrelevant (regexes anchor fully, no module name is a
	// prefix of another).
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_module",
			"__tmp_bb_scheme",
			"__tmp_bb_host",
			"__tmp_bb_port",
			"__tmp_bb_path",
		]
		separator    = "|"
		regex        = "http_2xx\\|(.*)\\|(.*)\\|(.*)\\|(.*)"
		replacement  = "${1}://${2}:${3}${4}"
		target_label = "__address__"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_module",
			"__tmp_bb_host",
			"__tmp_bb_port",
		]
		separator    = "|"
		regex        = "tcp_connect\\|(.*)\\|(.*)"
		replacement  = "${1}:${2}"
		target_label = "__address__"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_module",
			"__tmp_bb_host",
		]
		separator    = "|"
		regex        = "icmp\\|(.*)"
		replacement  = "${1}"
		target_label = "__address__"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_module",
			"__tmp_bb_host",
			"__tmp_bb_port",
		]
		separator    = "|"
		regex        = "tls_connect\\|(.*)\\|(.*)"
		replacement  = "${1}:${2}"
		target_label = "__address__"
	}

	// The module name is required on every blackbox target; it becomes
	// __param_module on export.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_module",
		]
		target_label = "module"
	}

	// Target name (required by prometheus.exporter.blackbox): the container
	// name, leading slash stripped. Also the human-facing series identity.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		replacement   = "$1"
		target_label  = "name"
	}

	// Provenance (manifest 6.1, 13.5): set as ordinary target labels here so
	// they survive the exporter (blackbox carries non-reserved target labels
	// through, then overwrites only its own base labels). environment/team
	// are optional; a missing docker label yields "" which relabel drops.
	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_environment",
		]
		target_label = "environment"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_team",
		]
		target_label = "team"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_com_docker_compose_project",
		]
		target_label = "compose_project"
	}

	rule {
		source_labels = [
			"__meta_docker_container_label_com_docker_compose_service",
		]
		target_label = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		replacement   = "$1"
		target_label  = "container"
	}

	rule {
		target_label = "collector"
		replacement  = "alloy"
	}

	rule {
		target_label = "host"
		replacement  = constants.hostname
	}
}

prometheus.exporter.blackbox "probes" {
	// Inline module allowlist (manifest 10.4.1): a module absent here cannot
	// be probed even if a container names it, because the relabel keep-rule
	// above already rejects unknown modules. Keep the keep-rule, the
	// composition rules and this config in sync.
	//
	// tls_connect skips chain verification on purpose: the label contract
	// has no channel to hand CA material to Alloy, so the reference module
	// proves the handshake and surfaces cert-expiry metrics; trusting a
	// chain needs an environment-specific module with ca_file (manifest
	// 10.4).
	config  = "{ modules: { http_2xx: { prober: http, timeout: \"5s\" }, tcp_connect: { prober: tcp, timeout: \"5s\" }, icmp: { prober: icmp, timeout: \"5s\" }, tls_connect: { prober: tcp, timeout: \"5s\", tcp: { tls: true, tls_config: { insecure_skip_verify: true } } } } }"
	targets = discovery.relabel.blackbox.output
}

// The exporter sets instance to its own in-memory address; recover the
// probed target from __param_target so series identify the target, not
// Alloy, and promote __param_module to a plain `module` label -- without
// it the __param_* labels are dropped at scrape time and probe_success
// series cannot be broken down by probe type (manifest 10.4).
discovery.relabel "enrich_blackbox" {
	targets = prometheus.exporter.blackbox.probes.targets

	rule {
		source_labels = ["__param_target"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__param_module"]
		target_label  = "module"
	}

	rule {
		target_label = "job"
		replacement  = "blackbox"
	}
}

// Profile allowlist (manifest 8.2): one thin filter/scrape pair per
// profile, keyed on the raw docker profile label (it survives the
// exporter); normal-v1 is the default when the label is unset, so only
// its regex also accepts the empty value.

discovery.relabel "blackbox_normal_v1" {
	targets = discovery.relabel.enrich_blackbox.output

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_profile",
		]
		regex  = "(normal-v1)?"
		action = "keep"
	}
}

prometheus.scrape "blackbox_normal_v1" {
	targets         = discovery.relabel.blackbox_normal_v1.output
	scrape_interval = "30s"
	scrape_timeout  = "10s"

	forward_to = [
		prometheus.remote_write.default.receiver,
	]
}

discovery.relabel "blackbox_fast_v1" {
	targets = discovery.relabel.enrich_blackbox.output

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_profile",
		]
		regex  = "(fast-v1)"
		action = "keep"
	}
}

prometheus.scrape "blackbox_fast_v1" {
	targets         = discovery.relabel.blackbox_fast_v1.output
	scrape_interval = "15s"
	scrape_timeout  = "10s"

	forward_to = [
		prometheus.remote_write.default.receiver,
	]
}

discovery.relabel "blackbox_slow_v1" {
	targets = discovery.relabel.enrich_blackbox.output

	rule {
		source_labels = [
			"__meta_docker_container_label_ru_3ops_discovery_blackbox_profile",
		]
		regex  = "(slow-v1)"
		action = "keep"
	}
}

prometheus.scrape "blackbox_slow_v1" {
	targets         = discovery.relabel.blackbox_slow_v1.output
	scrape_interval = "60s"
	scrape_timeout  = "15s"

	forward_to = [
		prometheus.remote_write.default.receiver,
	]
}
